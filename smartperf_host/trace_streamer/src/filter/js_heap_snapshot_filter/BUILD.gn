import("//build/ohos.gni")
import("../../../build/ts.gni")

config("js_heap_snapshot_filter_cfg") {
  include_dirs = [ "." ]
}

ohos_static_library("js_heap_snapshot_filter") {
  subsystem_name = "${OHOS_PROFILER_SUBSYS_NAME}"
  part_name = "${OHOS_PROFILER_PART_NAME}"
  sources = [
    "js_heap_snapshot_filter.cpp",
    "js_heap_snapshot_types.cpp",
  ]
  public_configs = [
    ":js_heap_snapshot_filter_cfg",
    "..:filter_cfg",
  ]
  deps = [ "../../trace_data:trace_data" ]
}
